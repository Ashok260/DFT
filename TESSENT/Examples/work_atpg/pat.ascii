ASCII_PATTERN_FILE_VERSION = 3;


SETUP = 

    declare input bus "PI" = "/clk", "/rst", "/scan_in_0", "/scan_en";

    declare output bus "PO" = "/Q[15]", "/Q[14]", "/Q[13]", "/Q[12]", "/Q[11]",
         "/Q[10]", "/Q[9]", "/Q[8]", "/Q[7]", "/Q[6]", "/Q[5]",
         "/Q[4]", "/Q[3]", "/Q[2]", "/Q[1]", "/Q[0]", "/scan_out_0";

    clock "/clk" =
        off_state   = 0;
        pulse_width = 1;
    end;

    clock "/rst" =
        off_state   = 1;
        pulse_width = 1;
    end;

    scan_group "grp1" =
        scan_chain "chain" =
            scan_in = "/scan_in_0";
            scan_out = "/scan_out_0";
            length = 16;
        end;
        procedure shift "grp1_load_shift" =
            force_sci "chain" 0;
            force "/clk" 1 20;
            force "/clk" 0 30;
            period 40;
        end;
        procedure shift "grp1_unload_shift" =
            measure_sco "chain" 10;
            force "/clk" 1 20;
            force "/clk" 0 30;
            period 40;
        end;
        procedure load "grp1_load" =
            force "/clk" 0 0;
            force "/rst" 1 0;
            force "/scan_en" 1 0;
            apply "grp1_load_shift" 16 40;
        end;
        procedure unload "grp1_unload" =
            force "/clk" 0 0;
            force "/rst" 1 0;
            force "/scan_en" 1 0;
            apply "grp1_unload_shift" 16 40;
        end;
    end;

end;

CHAIN_TEST =

    pattern = 0;
    apply "grp1_load" 0 =
        chain "chain" = "0011001100110011";
    end;
    force   "PI" "01XX" 1;
    measure "PO" "XXXXXXXXXXXXXXXXX" 2;
    apply "grp1_unload" 3 =
        chain "chain" = "0011001100110011";
    end;

end;

