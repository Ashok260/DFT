`celldefine
module rd3_512x16 (
    
    CE1,
    CE2,
    WEB1,
    WEB2,
    OEB1,
    OEB2,
    CSB1,
    CSB2,
    A1,
    A2,
    I1,
    I2,
    O1,
    O2

);
input           CE1;
input           CE2;
input           WEB1;
input           WEB2;
input           OEB1;
input           OEB2;
input           CSB1;
input           CSB2;
input  [8:0]    A1;
input  [8:0]    A2;
input  [15:0]   I1;
input  [15:0]   I2;
output [15:0]   O1;
output [15:0]   O2;

endmodule
`endcelldefine
