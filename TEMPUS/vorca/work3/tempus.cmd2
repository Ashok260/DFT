read_design vorca.dat/ vorca
report_fanout -from f32_mux_1_data_reg_5_/Q 
report_fanin -to  o_rd_data[5] -trace_through all
report_fanout -from i_hb_sup[1]  -trace_through all
report_fanout -clocktree
report_fanout -clock_tree 
report_clock_gating_check -view 
report_clock_gating_check -view 1
report_clock_gating_check -view all
report_clock_gating_check
create_clock -name clk -period $clk_period [get_ports clk]
set_input_delay [expr $clk_period/2] -clock clk[get_clocks clk] [all_inputs]
set_output_delay [expr $clk_period/2] -clock clk[get_clocks clk] [all_outputs]set_input_delay [expr $clk_period/2] [get_clocks clk] [all_inputs]
set_input_delay [expr $clk_period/2] [get_clocks clk] [all_inputs]
set_input_delay [expr $clk_period/2] -clock clk[get_clocks clk] [all_inputs]
set_input_delay [expr $clk_period/2] -clock [get_clocks clk] [all_inputs]
set_output_delay [expr $clk_period/2] -clock [get_clocks clk] [all_outputs]
