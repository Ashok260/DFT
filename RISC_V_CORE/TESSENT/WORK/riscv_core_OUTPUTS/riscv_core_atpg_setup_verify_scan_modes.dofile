set dofileName riscv_core_OUTPUTS/riscv_core_atpg_setup.dofile
set designFile /home/01fe21bec223/RISC_V_CORE/TESSENT/WORK/tsdb_outdir/dft_inserted_designs/riscv_core_gate.dft_inserted_design/riscv_core.vg
set topName {riscv_core}
set libName "../MDT/test_Nangate.mdt"


proc verify_all_scan_modes {} {
   set modeList [list unwrapped]
   foreach mode $modeList {
      set_system_mode setup
      reset_design
      tessent_scan_setup $mode
      set_edt_options off
      add_black_box -auto
      set_system_mode analysis
      report_scan_cells
   }
}


set_context patterns -scan
delete_design
read_cell_library $libName
read_verilog $designFile
set_current_design $topName
dofile $dofileName

verify_all_scan_modes
